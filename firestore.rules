rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAuthenticated() {
      return signedIn();
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function userRole() {
      return userDoc().role;
    }
    function getUserRole() {
      return userRole();
    }
    function isActive() {
      return signedIn() && userDoc().status == 'ACTIVE';
    }
    function isStaff() {
      return isActive() && userRole() in ['NAKES', 'ADMIN'];
    }
    function isAdmin() {
      return isActive() && userRole() == 'ADMIN';
    }
    function publicRoles() {
      return ['KADER', 'GURU', 'RATO', 'NAKES'];
    }
    function noSecretFields() {
      return !request.resource.data.keys().hasAny(['password', 'password_reset_at']);
    }

    match /users/{userId} {
      // Izinkan baca untuk pencarian login (lookup nomor WhatsApp/nama) dan profil faskes
      allow read: if true;

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role in publicRoles()
        && request.resource.data.status == 'PENDING_APPROVAL';

      // Nakes & Admin (isStaff) berhak penuh mengelola status, profil, dan mereset kata sandi akun
      allow update: if isStaff() || (
        signedIn() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
      );

      allow delete: if isAdmin() || isStaff();
    }

    match /villages/{villageId} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    match /reports/{reportId} {
      allow read: if isActive();
      allow create: if isActive() && noSecretFields()
        && request.resource.data.reporter_id == request.auth.uid;
      allow update, delete: if isStaff();
    }

    match /cases/{caseId} {
      allow read: if isActive();
      allow create, update: if isStaff() && noSecretFields();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isActive();
        allow create: if isActive() && noSecretFields();
        allow update, delete: if isStaff();
      }
    }

    match /chats/{chatId} {
      allow read: if isActive();
      allow create: if isActive()
        && noSecretFields()
        && request.resource.data.sender_id == request.auth.uid;
      allow update, delete: if isStaff();
    }
  }
}
